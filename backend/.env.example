# Meta OAuth 2.0 & Graph API
META_CLIENT_ID="your_meta_client_id"
META_CLIENT_SECRET="your_meta_client_secret"
META_CALLBACK_URL="https://localhost:3000/auth/callback"

# Upstash Redis
UPSTASH_REDIS_URL="your_upstash_redis_url"
UPSTASH_REDIS_TOKEN="your_upstash_redis_token"

# Backblaze B2 Storage
B2_ENDPOINT="your_b2_endpoint"
B2_ACCESS_KEY="your_b2_access_key"
B2_SECRET_KEY="your_b2_secret_key"
B2_BUCKET="your_bucket_name"
B2_PUBLIC_CUSTOM_DOMAIN="your_custom_domain"

# PostgreSQL & Supabase
POSTGRES_URL="your_postgres_connection_string"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"
SUPABASE_URL="your_supabase_url"
